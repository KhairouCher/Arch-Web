# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated template output (images + template.json from
# scripts/psd-to-json.py), including rollback snapshots from
# scripts/backup_template.sh. Kept local-only for now, same treatment as
# the source PSDs: there's no hosting or object storage to publish these
# to yet, so committing 60MB+ per template just bloats the repo. Once
# real hosting exists, these should be pushed to object storage (R2/S3)
# instead of committed here — see the planned scripts/publish_template
# step.
/public/templates/

# Generated sample photos (python seed/D-photos/make_photos.py)
/seed/D-photos/*.jpg
